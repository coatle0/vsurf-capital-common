{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivk-new-intake-1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "seed", "frame", "thesis"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "seed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "frame": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_links": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "references": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
