{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivk-universal-fact-0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "company_id", "fact_type", "value", "applicable_period", "evidence_ids", "content_hash", "epistemic_status", "review_status"],
  "properties": {
    "contract_version": {"const": "ivk-universal-fact-0.1"},
    "id": {"type": "string", "minLength": 1},
    "company_id": {"type": "string", "minLength": 1},
    "fact_type": {"type": "string", "minLength": 1},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "applicable_period": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_hash": {"type": "string", "minLength": 1},
    "derived": {"type": "boolean"},
    "derivation": {"type": ["string", "null"]},
    "epistemic_status": {"enum": ["fact", "graph_observation"]},
    "review_status": {"enum": ["pending", "accepted", "rejected", "deferred"]}
  }
}
